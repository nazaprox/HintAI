# HintAI backend environment
# Never commit real secrets.

GEMINI_API_KEY=

# Comma-separated frontend origins. Example:
# https://hintai-frontend-test.onrender.com,http://localhost:3000
ALLOWED_ORIGINS=https://hintai-frontend-test.onrender.com,http://localhost:3000

# Optional production settings
RENDER=true
LOG_LEVEL=INFO
